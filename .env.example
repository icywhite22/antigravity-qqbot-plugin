# QQ Bot 凭据（留空时可在后续支持扫码绑定或使用 QQ 开放平台配置）
QQBOT_APPID=
QQBOT_SECRET=

# 本地 QQ 网关与 MCP 回调监听端口
QQBOT_CALLBACK_PORT=39871
QQBOT_CALLBACK_HOST=127.0.0.1

# 数据与会话映射持久化目录（可选，默认 ~/.antigravity-qqbot）
QQBOT_DATA_DIR=

# 机器人与会话隔离工作区根目录（可选，默认 <QQBOT_DATA_DIR>/workspace）
# 运行时将按 <workspaceRoot>/bot-<appId>/<c2c|group>-<peerId>/ 自动创建隔离子目录
QQBOT_WORKSPACE_DIR=

# Antigravity 相关（一般由宿主环境变量自动注入）
ANTIGRAVITY_PROJECT_ID=
